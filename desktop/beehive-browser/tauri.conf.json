{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-v2-schema/main/tauri.conf.schema.json",
  "productName": "Beehive Browser",
  "version": "0.3.0",
  "identifier": "com.beehive.browser",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "http://107.173.70.124:8080"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https:; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' http: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' http: https:; font-src 'self' data: http: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "resources": {
      "cloakbrowser-core": "cloakbrowser-core"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": ["https://raw.githubusercontent.com/roymaste/beehive-releases/main/latest.json"]
    }
  }
}
